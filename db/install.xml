<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/ahotts_embhl/db" VERSION="20261107" COMMENT="XMLDB file for Moodle blocks/ahotts_embhl"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="block_ahotts_embhl_usage" COMMENT="Monthly totals of readings and downloads, per course. No personal data.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="period" TYPE="int" LENGTH="6" NOTNULL="true" SEQUENCE="false" COMMENT="Month in the server timezone, as YYYYMM"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course of the page; the site course for pages outside courses"/>
        <FIELD NAME="action" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="listen, audio or pdf"/>
        <FIELD NAME="total" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Times it happened that month"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="periodcourseaction" UNIQUE="true" FIELDS="period, courseid, action"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
