{{!
    @template block_ahotts_embhl/usage_report

    Monthly readings and downloads made with the Listen block.

    Context variables required for this template:
    * explained - What is counted, and when.
    * filters - HTML of the period and course selectors.
    * chart - HTML of the chart.
    * months - Newest first: label, listen, audio, pdf, downloads.
    * totals - listen, audio, pdf, downloads over those months.
    * showcourses - Whether to show one month course by course.
    * coursesheading - Heading of that table.
    * periodselect - HTML of its month selector.
    * courses - name (already formatted), url, listen, audio, pdf, downloads.
    * download - HTML of the download selector.

    Example context (json):
    {
        "explained": "A reading is counted each time the Listen button starts reading a page.",
        "filters": "",
        "chart": "",
        "months": [
            {"label": "November 2026", "listen": 120, "audio": 14, "pdf": 9, "downloads": 23},
            {"label": "October 2026", "listen": 95, "audio": 8, "pdf": 4, "downloads": 12}
        ],
        "totals": {"listen": 215, "audio": 22, "pdf": 13, "downloads": 35},
        "showcourses": true,
        "coursesheading": "Courses in November 2026",
        "periodselect": "",
        "courses": [
            {"name": "Bulegotika", "url": "#", "listen": 80, "audio": 10, "pdf": 5, "downloads": 15}
        ],
        "download": ""
    }
}}
<div class="block_ahotts_embhl-usage">
    <p class="text-muted">{{explained}}</p>
    <div class="d-flex flex-wrap align-items-center mb-3">{{{filters}}}</div>
    <div class="mb-4">{{{chart}}}</div>

    <h3>{{#str}}usagemonthly, block_ahotts_embhl{{/str}}</h3>
    <table class="table table-striped table-sm generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}}usagemonth, block_ahotts_embhl{{/str}}</th>
                <th scope="col" class="text-right">{{#str}}usagelisten, block_ahotts_embhl{{/str}}</th>
                <th scope="col" class="text-right">{{#str}}usageaudio, block_ahotts_embhl{{/str}}</th>
                <th scope="col" class="text-right">{{#str}}usagepdf, block_ahotts_embhl{{/str}}</th>
                <th scope="col" class="text-right">{{#str}}usagedownloads, block_ahotts_embhl{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#months}}
            <tr>
                <th scope="row">{{label}}</th>
                <td class="text-right">{{listen}}</td>
                <td class="text-right">{{audio}}</td>
                <td class="text-right">{{pdf}}</td>
                <td class="text-right">{{downloads}}</td>
            </tr>
            {{/months}}
        </tbody>
        {{#totals}}
        <tfoot>
            <tr class="font-weight-bold">
                <th scope="row">{{#str}}total{{/str}}</th>
                <td class="text-right">{{listen}}</td>
                <td class="text-right">{{audio}}</td>
                <td class="text-right">{{pdf}}</td>
                <td class="text-right">{{downloads}}</td>
            </tr>
        </tfoot>
        {{/totals}}
    </table>

    {{#showcourses}}
    <h3 class="mt-4">{{coursesheading}}</h3>
    <div class="mb-2">{{{periodselect}}}</div>
    {{#courses.0}}
    <table class="table table-striped table-sm generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}}usagecourse, block_ahotts_embhl{{/str}}</th>
                <th scope="col" class="text-right">{{#str}}usagelisten, block_ahotts_embhl{{/str}}</th>
                <th scope="col" class="text-right">{{#str}}usageaudio, block_ahotts_embhl{{/str}}</th>
                <th scope="col" class="text-right">{{#str}}usagepdf, block_ahotts_embhl{{/str}}</th>
                <th scope="col" class="text-right">{{#str}}usagedownloads, block_ahotts_embhl{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#courses}}
            <tr>
                <th scope="row"><a href="{{url}}">{{{name}}}</a></th>
                <td class="text-right">{{listen}}</td>
                <td class="text-right">{{audio}}</td>
                <td class="text-right">{{pdf}}</td>
                <td class="text-right">{{downloads}}</td>
            </tr>
            {{/courses}}
        </tbody>
    </table>
    {{/courses.0}}
    {{^courses.0}}
    <p>{{#str}}usagenodata, block_ahotts_embhl{{/str}}</p>
    {{/courses.0}}
    {{/showcourses}}

    <div class="mt-4">{{{download}}}</div>
</div>
